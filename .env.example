APP_NAME=JumpWeb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=jumpingjump
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Cola (#243): los emails transaccionales son `ShouldQueue`. En DEV usa `sync` → se envían en el acto
# y llegan a Mailpit SIN necesidad de un worker. En PRODUCCIÓN usa `database` (asíncrono, worker vía
# `schedule:run` del cron; ver `.env.production.example`). Para probar la cola en local: `database` + `php artisan queue:work`.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Docker (Sail) — puertos AISLADOS para no chocar con otros proyectos ---
APP_PORT=8080
VITE_PORT=5274
FORWARD_DB_PORT=3307
FORWARD_MAILPIT_PORT=1027
FORWARD_MAILPIT_DASHBOARD_PORT=8027
WWWGROUP=1000
WWWUSER=1000

# --- Redsys (audit hardening #113 A2) ---
# Clave secreta del comercio. Si se define aquí, tiene PRIORIDAD sobre `settings.redsys_secret_key`
# de BD: en Fase 9 con la clave REAL del banco, vivirá AQUÍ (en el vault de Enhance), nunca en BD
# donde un dump la expondría en claro. En desarrollo (sandbox) está vacía → usa el fallback de BD
# con la clave pública del manual oficial. NUNCA commitear la clave real al repo.
REDSYS_SECRET_KEY=
