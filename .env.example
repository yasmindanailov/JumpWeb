APP_NAME=JumpWeb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=jumpweb
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Cola (#243): los emails transaccionales son `ShouldQueue`. En DEV usa `sync` → se envían en el acto
# y llegan a Mailpit SIN necesidad de un worker. En PRODUCCIÓN usa `database` (asíncrono, worker vía
# `schedule:run` del cron; ver `.env.production.example`). Para probar la cola en local: `database` + `php artisan queue:work`.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Docker (Sail) — puertos AISLADOS para no chocar con otros proyectos ---
# Valores de dev de JumpWeb (web 8081 · MySQL 3308 · Mailpit 8028) — coherentes con la doc.
APP_PORT=8081
VITE_PORT=5274
FORWARD_DB_PORT=3308
FORWARD_MAILPIT_PORT=1027
FORWARD_MAILPIT_DASHBOARD_PORT=8028
WWWGROUP=1000
WWWUSER=1000

# --- API v1 (Fase 3) ---
# Suelo de peticiones por minuto de TODA la superficie `/api/v1`. Es infraestructura, no negocio:
# no se edita desde el panel (`config/api.php` explica por qué). Los endpoints sensibles llevan
# además su propio limitador, mucho más estricto.
API_RATE_LIMIT_PER_MINUTE=60
# Caducidad de los tokens Bearer del cliente móvil (Fase 6), en minutos. Por defecto 30 días.
# No afecta a la SPA, que va por cookie de sesión (`SESSION_LIFETIME`).
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
# Dominios que reciben cookie de sesión de Sanctum (modo SPA). Vacío = se deriva de `APP_URL`,
# que es lo correcto cuando la SPA vive en el mismo dominio que la web (el caso normal).
# SANCTUM_STATEFUL_DOMAINS=
# Orígenes con permiso CORS. Vacío = solo `APP_URL`. Nunca `*` — ver `config/cors.php`.
# CORS_ALLOWED_ORIGINS=

# --- Redsys (audit hardening #113 A2) ---
# Clave secreta del comercio. Si se define aquí, tiene PRIORIDAD sobre `settings.redsys_secret_key`
# de BD: en Fase 9 con la clave REAL del banco, vivirá AQUÍ (en el vault de Enhance), nunca en BD
# donde un dump la expondría en claro. En desarrollo (sandbox) está vacía → usa el fallback de BD
# con la clave pública del manual oficial. NUNCA commitear la clave real al repo.
REDSYS_SECRET_KEY=

# Reseñas de Google en la landing (`#491`). Places API (New) con el campo `reviews`.
# Restringida por IP (llamamos desde el servidor) y por API. Sin ella la sección usa
# las opiniones propias, que es la conducta correcta y no un fallo.
GOOGLE_PLACES_API_KEY=

# La herramienta de análisis (`specs/analitica.md` §4.3, T3a·2). El driver y su token PÚBLICO se eligen en
# «Ajustes»; aquí van solo las credenciales PRIVADAS del olvido (`ForgetPersonInDriver`): la clave personal
# de la API de PostHog con su id de proyecto (nube UE), o el `token_auth` de Matomo. Vacías = no se borra en
# el driver y queda anotado en el log.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
MATOMO_TOKEN_AUTH=
# Las APIs de conversiones (T3b): los ids públicos de los píxeles van en Ajustes; los tokens, solo aquí.
META_CAPI_ACCESS_TOKEN=
META_CAPI_VERSION=v21.0
TIKTOK_EVENTS_ACCESS_TOKEN=
