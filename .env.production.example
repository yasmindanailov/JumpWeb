# =============================================================================
# Jumpingjump — PLANTILLA de .env para PRODUCCIÓN (Fase 4 · go-live en Enhance)
# -----------------------------------------------------------------------------
# Esto es una PLANTILLA: cópiala al vault de Enhance y rellena los valores REALES.
# NO commitear el .env real ni ningún secreto. Referencia: docs/10-DESPLIEGUE.md §1.
# Diferencias clave frente al .env de desarrollo (.env.example):
#   APP_ENV=production · APP_DEBUG=false · APP_URL=https://… · cookies seguras ·
#   mailer real · LOG_LEVEL=warning · REDSYS_SECRET_KEY real (32 chars).
# =============================================================================

APP_NAME=JumpWeb
APP_ENV=production
APP_KEY=                          # php artisan key:generate (NO reutilizar la de dev)
APP_DEBUG=false
APP_URL=https://CAMBIAR.dominio   # dominio real con HTTPS (lo usa Redsys y los emails)

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Log: en producción nada de 'debug' (filtraría detalle). 'warning' o 'info'.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de datos real de Enhance. Contraseña ROBUSTA (no 'password').
DB_CONNECTION=mysql
DB_HOST=CAMBIAR
DB_PORT=3306
DB_DATABASE=CAMBIAR
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR

# Sesión: cookie SOLO por HTTPS en producción (la app va tras el proxy TLS de Enhance;
# bootstrap/app.php confía en los proxies para detectar el esquema).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Colas (D, #243): los emails transaccionales son ShouldQueue (no bloquean al cliente con el
# SMTP). DEBE ser 'database' (NO 'sync', que volvería a enviarlos en línea). El worker lo arranca
# el propio cron `schedule:run` (queue:work --stop-when-empty desde el scheduler; runbook §6) — sin
# servicio nuevo. La conexión 'database' tiene after_commit=true (config/queue.php).
QUEUE_CONNECTION=database

CACHE_STORE=database

# Correo REAL (SMTP/API del proveedor contratado). Sin esto NO se entrega ningún email
# (confirmación, código de entrada, post-form de invitados, reembolsos). Publicar SPF/DKIM/DMARC.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CAMBIAR
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR
MAIL_PASSWORD=CAMBIAR
MAIL_FROM_ADDRESS="no-reply@CAMBIAR.dominio"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Redsys (producción) -----------------------------------------------------
# La CLAVE SECRETA del comercio (32 chars, base64) vive SOLO aquí, nunca en BD/repo.
# La guarda del panel (Settings) impide pasar a 'live' mientras esta clave sea la de
# sandbox o no mida 32 chars. El resto (código de comercio FUC, terminal, entorno) se
# configura desde /admin/settings. Recuerda: tras desplegar, `php artisan optimize`
# hornea la config → verifica la clave EFECTIVA con el smoke-test del runbook §5.
REDSYS_SECRET_KEY=

# --- Cloudflare Turnstile (anti-bot) ----------------------------------------
# Si faltan, el anti-bot se autodesactiva (contacto/formularios quedan sin protección).
# Se configuran desde /admin/settings (security.turnstile_*), no aquí.
