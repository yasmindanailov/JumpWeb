#!/usr/bin/env bash
# Gate local de push (DECISIONES #9 y #10): no hay CI en la nube (sin facturación de GitHub
# Actions, decisión del owner) → NADA llega a `main` con la doc rota, Pint sucio o la suite roja.
# El gate aplica SOLO a `main`: las ramas `wip/…` pueden empujarse en rojo como copia de
# seguridad (CONVENCIONES §8) — nunca se mergean a main sin pasar por aquí.
# Si el push toca código crítico de dinero/aforo, exige además confirmar los comandos de
# concurrencia (la suite SQLite es ciega a las carreras InnoDB — INVARIANTES §6).
# Activación (una vez por clon): git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

remote="${1:-origin}"   # git pasa el nombre del remoto como $1
ZERO=0000000000000000000000000000000000000000
pushing_main=0
touched_critical=''
# Ficheros cuyo cambio exige los comandos verify-* (DECISIONES #10.c / INVARIANTES §6).
# Dos familias, por dos motivos distintos:
#
#  1. **El núcleo, por BASENAME** (no por ruta): la modularización de Fase 2 los movió de
#     app/Support a app/Domain/* y el gate tenía que seguirlos (hallazgo de la revisión del spec
#     de módulos).
#  2. **Los controladores de checkout de la API, por NOMBRE** (Fase 3 · paso 0, spec §9): un
#     endpoint que crea pedidos, inicia pagos o calcula disponibilidad orquesta exactamente las
#     carreras que la suite SQLite no puede ver, y con el patrón anterior no habría disparado
#     nada. No se incluye toda la carpeta a propósito: obligar a correr dos verificadores de 16
#     workers por tocar `MeController` convertiría el gate en algo que la gente aprende a saltarse.
#
# `PaymentInitiator` y `ReservationAdmissionPolicy` entran en la primera familia en Fase 3 · paso 2,
# cuando el código que protege `PAY-04` se muda a ellos: el UPDATE atómico que extiende la retención
# (partirlo en check+save resucita un hold vencido sin recontar aforo — hallazgo L2) y el
# `SUPERSEDED` de los intentos de cobro previos. Antes ese código vivía en un componente Livewire y
# en un controlador web, donde el gate nunca lo vio; que ahora tenga nombre propio es lo que permite
# vigilarlo.
#
# `ApiBoundariesTest` NO sustituye a esto: prohíbe que la lógica NAZCA en el controlador, pero un
# controlador que llama al OrderCreator correcto sigue pudiendo reordenar sus llamadas y romper
# `AFORO-01`. Que esta lista siga cubriendo lo que debe lo vigila `CriticalPathGateTest`.
#
# `SlotOffer` entra en Fase 3 · paso 4b, y llegaba tarde: `CriticalPathGateTest` ya lo trataba como
# núcleo —un controlador de API que lo tocara tenía que casar con este patrón— pero el fichero en sí
# no lo hacía. Es la fuente ÚNICA de oferta (`AFORO-02`) y `OrderCreator` la llama como backstop del
# corte intra-día (`passesIntradayFloor`), así que un cambio suyo puede mover lo que
# `purchase:verify-oversell` comprueba.
#
# `SlotAvailability` y `PackAvailability` entran el 2026-08-25, y llevaban fuera desde el principio.
# Son los DOS CONTADORES de aforo y dependencias DIRECTAS del constructor de `OrderCreator`: quienes
# deciden cuántas plazas quedan. El docblock de `PackAvailability` describe literalmente el contrato
# que estos verificadores existen para comprobar —«pensado para correr bajo `lockForUpdate` en
# OrderCreator (anti-sobreventa): el bloqueo de las franjas de la zona/día serializa las compras
# concurrentes»— y aun así tocarlo no disparaba nada. Mismo modo de fallo que `SlotOffer`: el gate
# vigilaba a quien LLAMA y no a quien CUENTA.
# ⚠️ No entra `ProductAvailability`, la tercera dependencia de aforo de `OrderCreator`: no cuenta
# plazas, solo mira si la hora cae en la ventana del día. La suite (SQLite) lo cubre entero, y
# `CriticalPathGateTest` lo fija como control negativo para que el gate no se vuelva un comodín.
#
# `ZoneDaySlotLock` y `OrderItemEditor` entran el 2026-08-27 (extracción 4b del desmontaje de
# `ViewOrder`, spec §9.6·4 y `#186`). El primero ES la receta anti-sobreventa de `AFORO-01`/`AFORO-05`
# —hasta hoy vivía DOS veces, en `OrderCreator` y en el panel— y el segundo será el dueño de la
# transacción de aforo de las ediciones del panel (el escenario `panel-edit` de
# `purchase:verify-oversell` es su instrumento). La suite (SQLite) no emite `FOR UPDATE`: solo los
# verificadores sobre MySQL ven lo que estos dos ficheros pueden romper.
# ⚠️ `MixedPartySurcharge` entra desde el 2026-08-29 con el mismo criterio que `WaiverSigner`:
# escribe dinero bajo `lockForUpdate` y tiene verificador propio sobre MySQL
# (`mixed-party:verify-concurrency`, visto FALLAR sin el lock: 12 líneas y 84,00 € donde debía haber
# 7,00 €). No estaba, y llevaba una jornada entera en producción de `main` sin gate.
# ⚠️ No entran `ItemEditPricing` ni `OrderItemEventDataWriter` (sus vecinos de la misma extracción):
# el primero es aritmética de solo lectura y el segundo no toca ni dinero ni aforo. Son los controles
# negativos de `CriticalPathGateTest`.
# ⚠️ `AgeFamilySealer` entra el 2026-08-31 (`specs/cumple-mixto.md` §21): no escribe dinero, escribe
# las CONDICIONES de las que sale el dinero del suplemento —la familia, los tramos y los precios con
# los que se vendió cada fiesta— dentro de los locks de `OrderCreator` y `OrderItemEditor`. Mismo
# criterio que `PackAvailability`: el gate vigila a quien decide, no solo a quien llama.
CRITICAL_RE='^(app/(.+/)?(OrderCreator|RedsysReturnHandler|SlotGenerator|SlotOffer|SlotAvailability|PackAvailability|PaymentInitiator|ReservationAdmissionPolicy|CheckoutOrchestrator|WaiverSigner|ZoneDaySlotLock|OrderItemEditor|MixedPartySurcharge|AgeFamilySealer)\.php|app/Http/Controllers/Api/(.+/)?(Order|Payment|Checkout|Quote|Availability|Cart)[A-Za-z]*\.php)$'

while read -r _local_ref local_sha remote_ref remote_sha; do
    [[ "$remote_ref" == "refs/heads/main" ]] || continue
    if [[ "$local_sha" == "$ZERO" ]]; then
        echo '⚠ pre-push: BORRADO de `main` en el remoto — el gate no aplica a deletes, pero esto destruye la rama principal.' >&2
        continue
    fi
    pushing_main=1
    # --no-renames: un rename puro solo listaría la ruta destino y escaparía a la guarda.
    if [[ "$remote_sha" == "$ZERO" ]]; then
        # main aún no existe en ESTE remoto: gatear lo que este remoto no tiene.
        if ! files=$(git log --format= --name-only --no-renames "$local_sha" --not --remotes="$remote" 2>&1); then
            echo '✗ pre-push: no puedo listar los commits nuevos para el remoto (git log falló). Gate cerrado.' >&2
            exit 1
        fi
    else
        if ! files=$(git diff --name-only --no-renames "$remote_sha" "$local_sha" 2>&1); then
            echo '✗ pre-push: no puedo calcular el diff contra el remoto (¿`git fetch` pendiente?). Gate cerrado.' >&2
            exit 1
        fi
    fi
    if hits=$(grep -E "$CRITICAL_RE" <<<"$files"); then
        touched_critical+="$hits"$'\n'
    fi
done

if [[ $pushing_main -eq 0 ]]; then
    echo '→ pre-push: no se empuja `main` — gate omitido (CONVENCIONES §8: wip/ puede ir en rojo).'
    exit 0
fi

if [[ -n "$touched_critical" && "${VERIFY_CONC:-0}" != "1" ]]; then
    echo '✗ pre-push: este push toca código crítico de dinero/aforo:' >&2
    sort -u <<<"${touched_critical%$'\n'}" | sed 's/^/    /' >&2
    echo '  La suite (SQLite) NO reproduce sus carreras (INVARIANTES §6). Corre lo que aplique:' >&2
    echo '    docker compose exec -u sail laravel.test php artisan redsys:verify-concurrency --workers=16' >&2
    echo '    docker compose exec -u sail laravel.test php artisan purchase:verify-oversell --workers=16' >&2
    echo '    docker compose exec -u sail laravel.test php artisan waiver:verify-chain --workers=16   # si tocas WaiverSigner' >&2
    echo '    docker compose exec -u sail laravel.test php artisan mixed-party:verify-concurrency --workers=12  # si tocas MixedPartySurcharge' >&2
    echo '  y confirma con:  VERIFY_CONC=1 git push' >&2
    exit 1
fi

echo '→ pre-push: docs-check…'
bash scripts/docs-check.sh

if ! docker compose ps --status running 2>/dev/null | grep -q 'laravel\.test'; then
    echo '✗ pre-push: el stack no está arriba. Arranca con `docker compose up -d` y reintenta.' >&2
    exit 1
fi

echo '→ pre-push: Pint (repo completo)…'
docker compose exec -u sail -T laravel.test ./vendor/bin/pint --test

# Build de assets ANTES de la suite, y por dos motivos independientes:
#  · `INVARIANTES SUITE-05` ya lo exigía («npm run build una vez antes de la suite completa: las
#    vistas dan `ViteManifestNotFound` sin manifest») y el hook no lo hacía;
#  · `public/build` está en `.gitignore`, así que el manifest no viaja en el commit. Un `@vite`
#    apuntando a un entry que no compila —o un manifest corrupto— se detecta cuando alguien carga
#    la web, no cuando se empuja. Ocurrió el 2026-08-13: un build interrumpido dejó
#    `manifest.json` a 0 bytes y TODA la web pública respondió 500.
# Cuesta ~3 s. La alternativa era gatearlo solo al tocar `resources/` o `vite.config.js`, que no
# habría cazado el manifest corrupto — que es justo el caso que pasó.
echo '→ pre-push: npm run build…'
docker compose exec -u sail -T laravel.test npm run build

# Máquina de estados del cajón SPA (Fase 4 · paso 4.1, `sidebar-spa.md` §4.8). Corre con el runner
# integrado de Node, sin dependencias: la máquina es un módulo JS plano justo para poder probarla
# así. Va aquí y no «cuando toque» porque la del sidebar Livewire tiene hoy seis ficheros de test
# detrás — transcribirla sin red sería una pérdida neta de cobertura, y el gate es lo único que
# garantiza que la red se ejecute. Cuesta <1 s.
# Bundle SSR del cajón (Fase 4 · paso 4.2). `SidebarDomContractTest` compara el ÁRBOL que emite
# cada motor, y para renderizar el de Vue en Node hace falta compilar sus `.vue`: Node no los carga
# solo. Se construye con Vite, como el bundle de cliente. Cuesta <2 s.
echo '→ pre-push: build SSR del cajón…'
docker compose exec -u sail -T laravel.test npm run build:ssr

echo '→ pre-push: tests JS (node --test)…'
docker compose exec -u sail -T laravel.test npm run test:js

echo '→ pre-push: suite completa (--parallel)…'
suite_log="$(mktemp)"

# ⚠️⚠️ **Si el gate cae, DICE DÓNDE ESTÁ SU SALIDA.** `DECISIONES #97`: el 2026-08-16 a las 00:02
# el pre-push cayó con 1 fallo, el reintento salió verde y **nunca se supo qué había fallado** —la
# salida se perdió—. El log ya existía (`tee` de aquí abajo) y `set -e` hace que el `rm` final no
# llegue a ejecutarse, así que el fichero SOBREVIVÍA… y nadie decía su nombre. Un rojo transitorio
# sin nombre no se puede arreglar: se reintenta, sale verde y la causa queda suelta para siempre.
# ⚠️ Y no basta con que el `tee` lo pinte en pantalla: eso es justo lo que se pierde al hacer scroll
# o al cerrar la terminal.
# `#164` midió que el reloj y el orden NO explican `#97`, así que la causa sigue viva: la próxima vez
# tiene que quedar capturada.
trap 'estado=$?; if [[ $estado -ne 0 && -s "${suite_log:-}" ]]; then
        echo "" >&2
        echo "▶ pre-push: la salida COMPLETA de la suite está en: ${suite_log}" >&2
        echo "  NO la borres antes de mirarla. Si reintentas y sale verde, ese fichero es la única" >&2
        echo "  prueba de qué falló (DECISIONES #97 se quedó sin ella)." >&2
      fi' EXIT

docker compose exec -u sail -T laravel.test php artisan test --parallel 2>&1 | tee "$suite_log"

# ── El CONTADOR de la suite en ESTADO.md, que hasta hoy no vigilaba nadie ─────────────────────
# ⚠️ `docs-check` NO lo comprueba: sus cuatro patrones son modelos, migraciones, invariantes y
# Resources, y «N tests» no casa con ninguno. Por eso derivó — el 2026-08-21 la doc decía 2715
# con la suite en 2642, y en esa MISMA sesión volvió a quedarse atrás dos veces más, una de ellas
# en el commit que acababa de retirar el duplicado por haber derivado.
# El gate ya tiene la cifra en la mano (acaba de correr la suite), así que compararla es gratis.
# `DECISIONES #116`. Fail-closed: si no se puede leer alguno de los cuatro números, se corta.
ran_tests=$(grep -a 'Tests:' "$suite_log" | grep -oE 'Tests:[[:space:]]+[0-9]+' | grep -oE '[0-9]+' | tail -1 || true)
ran_asserts=$(grep -a 'Assertions:' "$suite_log" | grep -oE 'Assertions:[[:space:]]+[0-9]+' | grep -oE '[0-9]+' | tail -1 || true)
# ⚠️ PHPUnit escribe DOS resúmenes: «Tests: N, Assertions: M, …» solo cuando hubo issues (notices,
# deprecations…) y «OK (N tests, M assertions)» cuando no hubo ninguna. Hasta el 2026-08-27 el gate
# solo entendía la primera — y funcionaba porque la suite llevaba UN notice de PHPUnit; al retirarlo
# (`RequiresStaffOrAdminTest`, cierre del carril A) el gate se quedó ciego. Fail-closed sigue igual.
if [[ -z "$ran_tests" ]]; then
    ran_tests=$(grep -aoE 'OK \([0-9]+ tests?, [0-9]+ assertions?\)' "$suite_log" | grep -oE '[0-9]+' | sed -n '1p' || true)
    ran_asserts=$(grep -aoE 'OK \([0-9]+ tests?, [0-9]+ assertions?\)' "$suite_log" | grep -oE '[0-9]+' | sed -n '2p' || true)
fi
doc_tests=$(grep -oE 'Suite \*\*[0-9]+ en verde\*\*' docs/ESTADO.md | grep -oE '[0-9]+' | head -1 || true)
doc_asserts=$(grep -oE 'Suite \*\*[0-9]+ en verde\*\* \([0-9.]+ aserciones' docs/ESTADO.md | grep -oE '\([0-9.]+' | tr -d '(.' | head -1 || true)
# Solo se borra si el gate va bien: si algo falla, el `trap` de arriba lo anuncia y el fichero
# se queda. Un log que se borra en el camino de error es un log que no existe.
rm -f "$suite_log"
trap - EXIT

if [[ -z "$ran_tests" || -z "$ran_asserts" || -z "$doc_tests" || -z "$doc_asserts" ]]; then
    echo '✗ pre-push: no he podido leer el contador de la suite o el que declara `docs/ESTADO.md`.' >&2
    echo '  Un número que no se ha podido comprobar NO es un número comprobado: gate cerrado.' >&2
    echo "  suite=[${ran_tests:-?}/${ran_asserts:-?}]  doc=[${doc_tests:-?}/${doc_asserts:-?}]" >&2
    exit 1
fi

if [[ "$ran_tests" != "$doc_tests" || "$ran_asserts" != "$doc_asserts" ]]; then
    echo '✗ pre-push: `docs/ESTADO.md` MIENTE sobre el tamaño de la suite.' >&2
    echo "    la suite acaba de dar:  ${ran_tests} tests · ${ran_asserts} aserciones" >&2
    echo "    ESTADO.md declara:      ${doc_tests} tests · ${doc_asserts} aserciones" >&2
    echo '  ▶ Corrige la línea «Suite **N en verde** (M aserciones…)» de `docs/ESTADO.md`.' >&2
    echo '    Es la ÚNICA copia del número a propósito; no la dupliques en otro documento.' >&2
    exit 1
fi
echo "→ pre-push: contador de ESTADO.md al día (${ran_tests} tests · ${ran_asserts} aserciones)."

echo '✓ pre-push: verde. Empujando main.'
