*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
# La capa agent-first SÍ se versiona (DECISIONES #7/#10): settings compartidos y skills.
# Lo demás de .claude/ (settings.local.json, estado de sesión…) queda fuera.
/.claude/*
!/.claude/settings.json
!/.claude/skills/
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
# El paquete de tema de la instalación (`DECISIONES #143`): es del CLIENTE, no del producto.
# Este repo es el PRODUCTO y no lleva la marca de nadie, así que su hoja no se versiona aquí.
# ⚠️ `deploy.sh` la excluye del `rsync --delete` por el mismo motivo que `public/uploads/`:
# no está en local, y sin la exclusión el primer despliegue la borraría del servidor.
/public/css/client.css
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/public/uploads
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Archivos temporales de diagnostico
/_*.php
/_*.html
/_*.png

# Vídeos: por defecto NO se versionan (fuentes pesadas / HEVC). EXCEPCIÓN: el vídeo del hero
# y su póster, ya optimizados y ligeros (~1,9 MB, H.264 720p), SÍ se versionan para que el
# repo sea un clon COMPLETO y desplegable (repositorio canónico). Ver docs/AUDIT-RENDIMIENTO.md §6.
/public/videos/*
!/public/videos/.gitkeep
!/public/videos/header_hero.mp4
!/public/videos/header_poster.jpg

# Fotos ORIGINALES de atracciones (~67 MB, fuente del cliente): NO se versionan.
# Las versiones optimizadas para web SI se versionan en /public/images/attractions.
/design_mockup/imagenesatracciones/
storage/ssr
