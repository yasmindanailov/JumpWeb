# Análisis estático del producto (`DECISIONES #625`, `[DECIDIDO owner]` 2026-09-17).
#
# Larastan = PHPStan con las extensiones que entienden Laravel (facades, Eloquent, el contenedor).
# Nivel 5 sobre `app/`, con LÍNEA BASE: lo que ya había el día que entró se congela en
# `phpstan-baseline.neon` y solo bloquea un error NUEVO. La línea base no se regenera para tapar
# un error nuevo: se arregla el error. Bajarla (arreglar lo congelado) siempre es bienvenido.
#
# Corre en el `pre-push` de `main`, detrás de Pint:
#   docker compose exec -u sail -T laravel.test ./vendor/bin/phpstan analyse --no-progress --memory-limit=2G
includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
