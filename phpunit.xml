<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!-- ⚠️⚠️ `array` SOPORTA tags y `database`/`file` LANZAN (medido, `DECISIONES #137`), así que
             la suite NO puede decidir por sí sola si un `Cache::tags()` funcionará en producción.
             El store por defecto se queda en `array` —rápido y aislado por test—, y quien ejercita
             los tags contra un Redis REAL es `CacheTaggingContractTest`, que apunta aquí abajo. -->
        <env name="CACHE_STORE" value="array"/>
        <!-- El Redis del `compose.yaml`, alcanzable por nombre de servicio dentro de la red `sail`.
             ⚠️ NO es opcional: los casos que miden los tags FALLAN si no está, a propósito. Redis es
             requisito DURO de la instalación (`#137`), así que un `skip` silencioso sería una guarda
             decorativa que quedaría verde para siempre en la máquina que no lo tenga. -->
        <env name="REDIS_HOST" value="redis"/>
        <env name="REDIS_PORT" value="6379"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!-- ❗❗ F5 · T2b (`DECISIONES #654`): la suite prueba el PRODUCTO, y el producto no tiene paquete
             de instancia. Sin esto la suite leía `INSTANCIA_RUTA` del `.env` de cada máquina, y el gate
             salía verde donde hay paquete y rojo donde no (medido el 19-09, `paquete-de-instancia.md`
             §4.5). La landing de una instancia se prueba con la huella de maquetación, no con PHPUnit. -->
        <env name="INSTANCIA_RUTA" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
